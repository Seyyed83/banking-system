# Oracle container initialization password (replace with a private local value)
ORACLE_PASSWORD=replace_with_a_strong_local_oracle_password

# Application database connection
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USERNAME=banking_app
DB_PASSWORD=replace_with_a_strong_local_database_password

# HTTP Basic credentials for protected API endpoints
BANKING_API_USERNAME=banking-admin
BANKING_API_PASSWORD=replace_with_a_strong_local_api_password
